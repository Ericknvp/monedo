rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == "BuTIPNKeBYTkDNeKku5mIpgWol03";
    }

    match /app_config/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /users/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update, delete: if request.auth != null && request.auth.uid == userId;
      allow list: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    match /accounts/{docId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    match /budgets/{docId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    match /categories/{docId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    match /categoryColors/{docId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    match /disabledCategories/{docId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    match /goals/{docId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    match /transactions/{docId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    match /recurringTransactions/{docId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // ── Módulo de Telegram ─────────────────────────────────────────
    // Lo que sigue es lo unico que se agrego a las reglas anteriores;
    // todo lo de arriba se mantiene igual.

    // PINs temporales de vinculacion. El ID del documento ES el PIN.
    //
    // El cliente crea el suyo y lo borra cuando caduca, asi que solo
    // puede operar sobre los PINs que le pertenecen. El bot lo canjea
    // con credenciales de administrador, que ignoran estas reglas.
    match /telegram_pins/{pin} {
      // El filtro por `uid` de la consulta de limpieza permite que
      // Firestore demuestre que solo devuelve PINs del propio usuario.
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.pin == pin
                    && request.resource.data.used == false
                    && request.resource.data.expiresAt is timestamp;

      // Un PIN emitido no se edita desde el cliente.
      allow update: if false;

      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // Relacion chat_id <-> uid. La clave del documento es el chat.id
    // de Telegram, no el uid: asi un chat no puede quedar vinculado a
    // dos cuentas (el segundo vinculo es estructuralmente imposible) y
    // el bot resuelve de que cuenta es un chat con una lectura directa.
    match /telegram_links/{chatId} {
      // El cliente solo lee y borra los vinculos cuya cuenta es la suya.
      // Para listar, la consulta se filtra por `uid` y la condicion de
      // la regla se puede comprobar con ese filtro.
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;

      // Desvincular: cada usuario borra su propio vinculo.
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;

      // Si el cliente pudiera escribir aqui, un usuario podria enlazar
      // un chat ajeno a su cuenta.
      allow create, update: if false;
    }
  }
}
